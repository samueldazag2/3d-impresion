DB_URL=jdbc:postgresql://localhost:5432/printcoststudio
DB_USERNAME=printcoststudio
DB_PASSWORD=changeme
SPRING_PROFILES_ACTIVE=local

# HS256 signing key for JWTs - generate with `openssl rand -base64 48`, at least 32 bytes.
JWT_SECRET=changeme-generate-a-real-32-byte-secret

# Comma-separated list of frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial ADMIN account, created on first boot if it doesn't exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
